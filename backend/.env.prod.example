# 운영(prod) 환경변수 예시. 실제 값은 backend/.env.prod(로컬 점검용, gitignore) 또는
# 배포 서비스의 환경변수 설정에 넣는다. 이 파일에는 실제 값을 넣지 않는다.
SPRING_PROFILES_ACTIVE=prod

# Supabase > Connect > Session pooler (JDBC). sslmode=require 필수 (없으면 기동 거부)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_POOL_SIZE=5

# 32바이트 이상 임의 문자열 (로컬 .env 와 다른 값). 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=120

# 운영 프론트 origin (쉼표 구분). localhost 를 넣지 않는다
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
# 프론트와 API 가 같은 사이트면 Lax, 서로 다른 사이트(예: *.vercel.app ↔ 다른 도메인)면 None
COOKIE_SAME_SITE=Lax

# 첫 관리자 (선택). 만든 뒤에는 비운다
ADMIN_EMAIL=
ADMIN_PASSWORD=
