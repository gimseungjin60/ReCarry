# 로컬 개발용. backend/.env 로 복사해서 값을 채운다. .env 는 git 에 올리지 않는다.
# 운영(Supabase) 설정은 .env.prod.example 을 본다.
DB_URL=jdbc:postgresql://localhost:5433/recarry
DB_USERNAME=recarry
DB_PASSWORD=
# 32바이트 이상 임의 문자열. 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=120
SPRING_PROFILES_ACTIVE=local
# 로컬은 Vite proxy(같은 origin)라 비워도 된다
CORS_ALLOWED_ORIGINS=
# 로컬(http)에서는 local 프로필이 쿠키 Secure 를 끈다. 바꿀 일은 거의 없다
# COOKIE_SECURE=false
# 첫 관리자 (선택)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 통합 테스트용 DB (이름에 test 가 들어가야 한다 — 테스트가 매번 비우고 다시 migrate 한다)
TEST_DB_URL=jdbc:postgresql://localhost:5433/recarry_test
TEST_DB_USERNAME=recarry
TEST_DB_PASSWORD=
